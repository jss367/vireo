---
import Base from '../layouts/Base.astro';
import helpData from '../../../vireo/static/help.json';

const base = import.meta.env.BASE_URL;

// Group help entries by category, preserving insertion order
const grouped: Record<string, typeof helpData> = {};
for (const entry of helpData) {
  const cat = entry.category || 'Other';
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(entry);
}
---

<Base title="Docs — Vireo" description="Getting started with Vireo and FAQ.">

  <section class="section section--dark docs-header">
    <div class="container">
      <h1>Documentation</h1>
      <p class="docs-header__subtitle">Everything you need to get started with Vireo.</p>
    </div>
  </section>

  <!-- Getting Started -->
  <section class="section" id="getting-started">
    <div class="container docs-section">
      <h2>Getting started with Vireo</h2>
      <p>Choose a small folder of wildlife photos already on your computer. Include a few frames of the same animal taken seconds apart so you can compare them and choose a keeper.</p>

      <div class="docs-step" id="install">
        <h3>1. Install Vireo</h3>
        <p>Get the installer for your computer from the <a href={`${base}download/`}>download page</a>. On macOS, open the disk image and drag Vireo to Applications. On Windows 11, run the setup wizard. On Linux, install the .deb package.</p>
        <p>Open Vireo. On the welcome screen, choose <strong>Get Started</strong> to download the identification model. If prompted, choose your region and wildlife groups and click <strong>Download species list</strong>. Setup finishes in <strong>Browse</strong>, where your photos will appear.</p>
      </div>

      <div class="docs-step" id="first-import">
        <h3>2. Import your first folder</h3>
        <p>Open <strong>Import</strong>, leave <strong>Add in place</strong> selected, and click <strong>Browse…</strong> to choose your folder. Vireo catalogs the photos where they are.</p>
        <p>Under <strong>After import</strong>, choose <strong>None — import only</strong> so you can start the analysis yourself. Click <strong>Start import</strong>. When it finishes, choose <strong>Open Browse</strong> and check that you recognize the photos from your folder.</p>
      </div>

      <div class="docs-step" id="first-process">
        <h3>3. Run Process on that folder</h3>
        <p>Open <strong>Process</strong>. Under <strong>Workspace Folders</strong>, select just the folder you imported. Under <strong>AI processing</strong>, choose <strong>Cull-ready</strong> to identify wildlife and group related frames for review.</p>
        <p>Click <strong>Start Pipeline</strong>. The first run may download additional models before analyzing the photos on your computer. You can follow progress in <strong>Jobs</strong>. A successful run opens <strong>Process Review</strong> automatically. If Process shows completion notes, read them and follow the link to review.</p>
      </div>

      <div class="docs-step" id="first-review">
        <h3>4. Review the results and pick a keeper</h3>
        <p>Find a burst of the same animal in <strong>Process Review</strong>. If a frame is labeled <strong>KEEP</strong>, start there. Click its thumbnail to inspect the eye and pose, then look at a neighboring frame. If the second photo catches the bird looking toward you and its eye is sharp, you might prefer it.</p>
        <p>Back in the grid, right-click your favorite thumbnail and choose the flag icon labeled <strong>Flag as pick</strong>. This works on any frame, including Vireo’s suggested keeper or a single photo. A <strong>P</strong> badge on the thumbnail confirms your pick.</p>
      </div>
    </div>
  </section>

  <!-- Detailed guides -->
  <section class="section section--light" id="guides">
    <div class="container docs-section">
      <div class="section-heading-row">
        <div>
          <p class="section-kicker">Detailed guides</p>
          <h2>Understand every decision</h2>
        </div>
        <p class="section-intro">Visual, task-oriented references for Vireo's most powerful workflows.</p>
      </div>

      <a class="guide-card" href={`${base}docs/process-review/`}>
        <div class="guide-card__art" aria-hidden="true">
          <span class="guide-card__encounter">
            <i></i><i></i><i></i><i></i>
          </span>
          <span class="guide-card__decision">Review</span>
        </div>
        <div class="guide-card__body">
          <div class="guide-card__eyebrow">
            <span>Process Review</span>
            <span class="guide-card__badge">Design preview</span>
          </div>
          <h3>Review encounters, predictions, and grouping</h3>
          <p>Learn how to narrow a large review without losing context, resolve species disagreements, work with multiple models, and correct burst or encounter boundaries.</p>
          <span class="guide-card__link">Read the detailed guide <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container docs-section">
      <h2>FAQ</h2>

      <div class="faq-search">
        <input type="text" id="faqSearchInput" placeholder="Search help topics..." autocomplete="off" />
      </div>

      <div id="faqNoResults" class="faq-no-results" style="display:none;">
        No results found. Try different keywords.
      </div>

      <div id="faqEntries">
        {Object.entries(grouped).map(([category, entries]) => (
          <div class="faq-group" data-category={category}>
            <div class="faq-category-heading">{category}</div>
            {entries.map((entry) => (
              <div class="faq-item" data-question={entry.question} data-keywords={entry.keywords.join(',')} data-answer={entry.answer} data-cat={entry.category}>
                <h3>{entry.question}</h3>
                <span class="faq-badge">{entry.category}</span>
                <p>{entry.answer}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GitHub Callout -->
  <section class="section section--navy">
    <div class="container github-callout">
      <h2>Looking for more?</h2>
      <p>For technical documentation, troubleshooting, developer interfaces, and contributing guidelines, visit the project on GitHub.</p>
      <a href="https://github.com/jss367/vireo" class="btn btn--primary btn--large" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </section>

</Base>

<style>
  .docs-header {
    text-align: center;
    padding-bottom: var(--space-3xl);
  }

  .docs-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .docs-header__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
  }

  /* Docs sections */
  .docs-section h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2xl);
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  .section-heading-row h2 {
    margin-bottom: 0;
  }

  .section-kicker {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
  }

  .section-intro {
    color: var(--color-text-muted);
    max-width: 420px;
  }

  .guide-card {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    overflow: hidden;
    color: var(--color-text-on-light);
    background: var(--color-bg-white);
    border: 1px solid rgba(58, 53, 32, 0.12);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .guide-card:hover {
    color: var(--color-text-on-light);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .guide-card__art {
    min-height: 250px;
    display: grid;
    place-items: center;
    position: relative;
    background:
      radial-gradient(circle at 72% 30%, rgba(255, 255, 255, 0.72), transparent 28%),
      linear-gradient(145deg, #eef7ef, #e6f2f6);
  }

  .guide-card__encounter {
    width: min(78%, 290px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(44, 93, 68, 0.2);
    border-radius: 12px;
    box-shadow: 0 16px 36px rgba(37, 74, 55, 0.12);
  }

  .guide-card__encounter i {
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    background: linear-gradient(150deg, #8eb49a, #cbdcbd);
  }

  .guide-card__encounter i:nth-child(2) { background: linear-gradient(150deg, #6f9e80, #b9d2c1); }
  .guide-card__encounter i:nth-child(3) { background: linear-gradient(150deg, #d8ba74, #f1dfad); }
  .guide-card__encounter i:nth-child(4) { background: linear-gradient(150deg, #7ea6ac, #c1d8db); }

  .guide-card__decision {
    position: absolute;
    right: 9%;
    bottom: 17%;
    padding: 5px 10px;
    color: #694d00;
    background: #fff4c7;
    border: 1px solid #e6c95e;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }

  .guide-card__body {
    padding: var(--space-2xl);
    align-self: center;
  }

  .guide-card__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .guide-card__badge {
    padding: 3px 8px;
    color: #315e70;
    background: #e8f4f8;
    border-radius: 999px;
    font-size: var(--text-xs);
  }

  .guide-card h3 {
    font-size: var(--text-2xl);
    line-height: 1.25;
    margin-bottom: var(--space-md);
  }

  .guide-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    max-width: 650px;
  }

  .guide-card__link {
    color: var(--color-accent-hover);
    font-weight: 700;
  }

  /* Getting Started steps */
  .docs-step {
    margin-bottom: var(--space-xl);
  }

  .docs-step h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .docs-step p {
    color: var(--color-text-muted);
    max-width: 700px;
  }

  /* FAQ search */
  .faq-search {
    margin-bottom: var(--space-2xl);
  }

  .faq-search input {
    width: 100%;
    max-width: 500px;
    padding: 12px 16px;
    font-size: var(--text-base);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    background: #fff;
    color: var(--color-text);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }

  .faq-search input:focus {
    border-color: var(--color-primary, #2563eb);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .faq-search input::placeholder {
    color: var(--color-text-muted);
  }

  /* FAQ category headings */
  .faq-category-heading {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: var(--space-2xl) 0 var(--space-md);
  }

  .faq-group:first-child .faq-category-heading {
    margin-top: 0;
  }

  .faq-badge {
    display: inline-block;
    font-size: var(--text-xs, 0.75rem);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs, 0.25rem);
  }

  .faq-no-results {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-3xl) 0;
    font-size: var(--text-base);
  }

  /* FAQ items */
  .faq-item {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .faq-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .faq-item h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .faq-item p {
    color: var(--color-text-muted);
    max-width: 700px;
  }

  .faq-item code {
    background: rgba(0, 0, 0, 0.06);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* Hidden state for search filtering */
  .faq-item.hidden,
  .faq-group.hidden {
    display: none;
  }

  /* GitHub callout */
  .github-callout {
    text-align: center;
  }

  .github-callout h2 {
    font-size: var(--text-3xl);
    color: var(--color-warm-white);
    margin-bottom: var(--space-md);
  }

  .github-callout p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 720px) {
    .section-heading-row {
      display: block;
    }

    .section-intro {
      margin-top: var(--space-md);
    }

    .guide-card {
      grid-template-columns: 1fr;
    }

    .guide-card__art {
      min-height: 190px;
    }

    .guide-card__body {
      padding: var(--space-xl);
    }
  }
</style>

<script>
  import Fuse from 'fuse.js';

  const items = Array.from(document.querySelectorAll('.faq-item')).map(el => ({
    question: el.getAttribute('data-question') || '',
    keywords: (el.getAttribute('data-keywords') || '').split(','),
    answer: el.getAttribute('data-answer') || '',
    category: el.getAttribute('data-cat') || ''
  }));

  const fuse = new Fuse(items, {
    keys: [
      { name: 'question', weight: 3 },
      { name: 'keywords', weight: 2 },
      { name: 'answer', weight: 1 }
    ],
    threshold: 0.4,
    includeMatches: true
  });

  const input = document.getElementById('faqSearchInput') as HTMLInputElement;
  const entriesContainer = document.getElementById('faqEntries')!;
  const noResults = document.getElementById('faqNoResults')!;
  const allItems = entriesContainer.querySelectorAll<HTMLElement>('.faq-item');
  const allGroups = entriesContainer.querySelectorAll<HTMLElement>('.faq-group');

  function showAll() {
    allItems.forEach(el => el.classList.remove('hidden'));
    allGroups.forEach(el => el.classList.remove('hidden'));
    // Restore category headings visibility
    entriesContainer.querySelectorAll<HTMLElement>('.faq-category-heading').forEach(el => {
      el.style.display = '';
    });
    noResults.style.display = 'none';
  }

  function filterBySearch(query: string) {
    if (!query.trim()) {
      showAll();
      return;
    }

    const hits = fuse.search(query);

    if (hits.length === 0) {
      allItems.forEach(el => el.classList.add('hidden'));
      allGroups.forEach(el => el.classList.add('hidden'));
      noResults.style.display = '';
      return;
    }

    noResults.style.display = 'none';

    // Build set of matching questions
    const matchingQuestions = new Set(hits.map(h => h.item.question));

    // Hide category headings during search (results shown flat)
    entriesContainer.querySelectorAll<HTMLElement>('.faq-category-heading').forEach(el => {
      el.style.display = 'none';
    });

    // Show/hide individual items
    allItems.forEach(el => {
      const q = el.getAttribute('data-question');
      if (q && matchingQuestions.has(q)) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    // Show all groups (items inside handle their own visibility)
    allGroups.forEach(el => el.classList.remove('hidden'));
  }

  input.addEventListener('input', () => filterBySearch(input.value));
</script>
